{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug con tsx",
            "type": "node",
            "request": "launch",
            "program": "${file}", // Debugga il file attualmente aperto
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "tsx"
            ],
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**",
                "${workspaceFolder}/node_modules/**"
            ]
        }
    ]
}