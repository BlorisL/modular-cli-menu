{
    "version": "1.4.0",
    "name": "modular-cli-menu",
    "description": "",
    "keywords": [
        "nodejs",
        "cli",
        "modular",
        "command-line",
        "menu",
        "inquirer ",
        "terminal"
    ],
    "author": "Loris Salvi",
    "license": "MIT",
    "homepage": "https://github.com/BlorisL/modular-cli-menu/blob/main/README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/blorisl/modular-cli-menu.git"
    },
    "dependencies": {
        "@inquirer/checkbox": "^4.1.6",
        "@inquirer/input": "^4.1.10",
        "@inquirer/select": "^4.2.1",
        "@types/inquirer": "^9.0.7",
        "chalk": "^5.4.1",
        "dotenv": "^16.6.1",
        "inquirer": "^9.2.12"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/npm": "^13.1.2",
        "@types/node": "^20.9.0",
        "clean-pkg-json": "^1.3.0",
        "eslint": "^10.0.3",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "pkgroll": "^2.12.2",
        "prettier": "^3.8.1",
        "tsx": "^4.19.3",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.57.1"
    },
    "types": "./dist/index.d.ts",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
        },
        "./index": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "bin": {
        "modular-cli-menu": "./dist/index.mjs"
    },
    "files": [
        "package.json",
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "tsx src/dev.ts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "fix": "npm run lint:fix && npm run format",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false",
        "build:en": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false --env.MENU_LANGUAGE=it",
        "build:it": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false --env.MENU_LANGUAGE=it",
        "pack:test": "npm pack --dry-run",
        "prepack": "clean-pkg-json -r scripts,plugins",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "**/*.json": [
            "prettier --write"
        ]
    },
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/npm",
            {
                "updatePackageJson": true,
                "npmPublish": true
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "package.json"
                ],
                "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
            }
        ]
    ]
}
