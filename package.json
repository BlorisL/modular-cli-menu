{
    "version": "1.4.0",
    "name": "modular-cli-menu",
    "description": "",
    "main": "./dist/main.mjs",
    "types": "./dist/main.d.mts",
    "exports": {
        ".": {
            "types": "./dist/main.d.mts",
            "import": "./dist/main.mjs"
        }
    },
    "keywords": [
        "nodejs",
        "cli",
        "modular",
        "command-line",
        "menu",
        "inquirer ",
        "terminal"
    ],
    "author": "Loris Salvi",
    "license": "MIT",
    "homepage": "https://github.com/BlorisL/modular-cli-menu/blob/main/README.md",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/blorisl/modular-cli-menu.git"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "dependencies": {
        "@inquirer/checkbox": "^5.1.4",
        "@inquirer/core": "^11.1.9",
        "@inquirer/input": "^5.0.12",
        "@inquirer/select": "^5.1.4",
        "@types/inquirer": "^9.0.9",
        "chalk": "^5.6.2",
        "dotenv": "^17.4.2",
        "inquirer": "^13.4.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.2",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^25.6.0",
        "czg": "^1.12.0",
        "eslint": "^10.2.1",
        "eslint-plugin-jsonc": "^3.1.2",
        "http-server": "^14.1.1",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "tsdown": "^0.21.10",
        "tsx": "^4.21.0",
        "typedoc": "^0.28.19",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "prepare": "husky",
        "dev": "tsx src/dev.ts",
        "git:commit": "czg",
        "example": "f() { tsx src/examples/example-${1}.ts; }; f",
        "test": "tsx src/tests/test1.ts",
        "style:dry": "eslint .",
        "style:apply": "eslint . --fix",
        "build": "npx tsdown src/main.ts --format esm --dts --clean --minify --env.DEBUG_LOG=false --out-dir dist",
        "build:en": "npx tsdown src/main.ts --format esm --dts --clean --minify --env.DEBUG_LOG=false --env.DEFAULT_LANGUAGE=en --out-dir dist",
        "build:it": "npx tsdown src/main.ts --format esm --dts --clean --minify --env.DEBUG_LOG=false --env.DEFAULT_LANGUAGE=it --out-dir dist",
        "build:test": "npm pack --dry-run",
        "pack": "npm run build && npm pack",
        "publish:dry": "npm run build && npm publish --dry-run",
        "docs:generate": "typedoc",
        "docs:serve": "http-server docs -p 8080 -c-1 -o"
    },
    "lint-staged": {
        "**/*.{ts,json}": [
            "eslint --fix"
        ]
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "volta": {
        "node": "22.18.0"
    }
}
