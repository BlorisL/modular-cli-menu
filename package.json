{
  "version": "1.4.0",
  "name": "modular-cli-menu",
  "description": "",
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "require": "./dist/main.cjs"
    }
  },
  "keywords": [
    "nodejs",
    "cli",
    "modular",
    "command-line",
    "menu",
    "inquirer ",
    "terminal"
  ],
  "author": "Loris Salvi",
  "license": "MIT",
  "homepage": "https://github.com/BlorisL/modular-cli-menu/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/blorisl/modular-cli-menu.git"
  },
  "dependencies": {
    "@inquirer/checkbox": "^4.1.6",
    "@inquirer/input": "^4.1.10",
    "@inquirer/select": "^4.2.1",
    "@types/inquirer": "^9.0.7",
    "chalk": "^5.4.1",
    "dotenv": "^16.6.1",
    "inquirer": "^9.2.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.9.0",
    "clean-pkg-json": "^1.3.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pkgroll": "^2.12.2",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.57.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/dev.ts",
    "commit": "git-cz",
    "example": "f() { tsx src/examples/example-${1}.ts; }; f",
    "test": "tsx src/tests/test1.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "npm run lint:fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false",
    "build:en": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false --env.MENU_LANGUAGE=it",
    "build:it": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false --env.MENU_LANGUAGE=it",
    "pack:test": "npm pack --dry-run",
    "publish:dry": "npm run build && npm publish --dry-run",
    "prepack": "clean-pkg-json -r scripts,plugins",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.json": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
