{
    "version": "1.4.0",
    "name": "modular-cli-menu",
    "description": "",
    "main": "./dist/main.js",
    "types": "./dist/main.d.ts",
    "exports": {
        ".": {
            "types": "./dist/main.d.ts",
            "import": "./dist/main.js",
            "require": "./dist/main.cjs"
        }
    },
    "keywords": [
        "nodejs",
        "cli",
        "modular",
        "command-line",
        "menu",
        "inquirer ",
        "terminal"
    ],
    "author": "Loris Salvi",
    "license": "MIT",
    "homepage": "https://github.com/BlorisL/modular-cli-menu/blob/main/README.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/blorisl/modular-cli-menu.git"
    },
    "dependencies": {
        "@inquirer/checkbox": "^5.1.4",
        "@inquirer/input": "^5.0.12",
        "@inquirer/select": "^5.1.4",
        "@types/inquirer": "^9.0.9",
        "chalk": "^5.6.2",
        "dotenv": "^17.4.2",
        "inquirer": "^13.4.2"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.2",
        "@commitlint/config-conventional": "^20.5.0",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^25.6.0",
        "clean-pkg-json": "^1.4.2",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^10.2.1",
        "eslint-plugin-jsonc": "^3.1.2",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "pkgroll": "^2.27.0",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.1"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "prepare": "husky",
        "dev": "tsx src/dev.ts",
        "git:commit": "git-cz",
        "example": "f() { tsx src/examples/example-${1}.ts; }; f",
        "test": "tsx src/tests/test1.ts",
        "style:dry": "eslint .",
        "style:apply": "eslint . --fix",
        "build": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false",
        "build:en": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false --env.MENU_LANGUAGE=en",
        "build:it": "npx pkgroll --clean-dist --minify --env.DEBUG_LOG=false --env.MENU_LANGUAGE=it",
        "build:test": "npm pack --dry-run",
        "publish:dry": "npm run build && npm publish --dry-run"
    },
    "lint-staged": {
        "**/*.{ts,json}": [
            "eslint --fix"
        ]
    },
    "config": {
        "commitizen": {
            "path": "cz-conventional-changelog"
        }
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
