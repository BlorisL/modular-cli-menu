{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "strict": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "paths": {
            "@/*": ["./src/*"],
            "@prompts/*": ["./src/prompts/*"]
        }
    },
    "include": ["src/**/*"]
}
